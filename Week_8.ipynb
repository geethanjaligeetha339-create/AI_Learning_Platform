   "source": [
    "WEEK -08 : Implement a linear Regression algorithm in order to fit data points.\n",
    "           Select the appropriate data set for your experiment and draw graphs."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "8b76c0ce-d93e-4a52-afc2-ac4182b992a9",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
import pandas as pd
    "import matplotlib.pyplot as plt "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "b133ed62-b4f2-4058-8af1-c7efb7b32931",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Function to estimate regression coefficients\n",
    "def estimate_coef(x, y):\n",
    "    # Number of observations/points\n",
    "    n = np.size(x)\n",
    "\n",
    "    # Mean of x and y\n",
    "    m_x = np.mean(x)\n",
    "    m_y = np.mean(y)\n",
    "\n",
    "    # Calculating cross-deviation and deviation about x\n",
    "    SS_xy = np.sum(y * x) - n * m_y * m_x\n",
    "    SS_xx = np.sum(x * x) - n * m_x * m_x\n",
    "\n",
    "    # Calculating regression coefficients\n",
    "    b_1 = SS_xy / SS_xx\n",
    "    b_0 = m_y - b_1 * m_x\n",
    "\n",
    "    return (b_0, b_1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "a7d85478-7523-4f2f-9944-8fcc759832fc",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Function to plot the regression line\n",
    "def plot_regression_line(x, y, b):\n",
    "    # Plot the actual data points\n",
    "    plt.scatter(x, y, color=\"blue\", label=\"Data points\")\n",
    "\n",
    "    # Predicted regression line\n",
    "    y_pred = b[0] + b[1] * x\n",
    "    plt.plot(x, y_pred, color=\"red\", label=\"Regression line\")\n",
    "\n",
    "    # Add labels and title\n",
    "    plt.xlabel(\"X\")\n",
    "    plt.ylabel(\"Y\")\n",
    "    plt.title(\"Linear Regression\")\n",
    "    plt.legend()\n",
    "    plt.show()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "e46e17d1-e2e4-4f2c-9fa6-9ab2cd378ce5",
